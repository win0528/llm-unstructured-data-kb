{
  "项目名称": "大模型数据预处理系统",
  "版本": "1.0.0",
  "功能模块": [
    {
      "名称": "文档解析",
      "描述": "支持多种格式文档的自动解析",
      "支持格式": ["PDF", "Word", "TXT", "Markdown", "HTML", "CSV", "JSON", "RTF", "PPTX", "EPUB"]
    },
    {
      "名称": "文本清洗",
      "描述": "去除噪声、标准化文本格式",
      "功能": ["去乱码", "去空行", "去页码", "过滤短文本"]
    },
    {
      "名称": "隐私脱敏",
      "描述": "自动识别并脱敏敏感信息",
      "脱敏类型": ["手机号", "身份证", "邮箱", "网址"]
    },
    {
      "名称": "智能分块",
      "描述": "基于语义的文本分块算法",
      "特点": ["保持语义完整", "支持重叠", "可配置块大小"]
    }
  ],
  "技术栈": {
    "文档解析": ["pdfplumber", "python-docx", "python-pptx"],
    "向量化": ["sentence-transformers", "BGE"],
    "向量数据库": ["ChromaDB"],
    "界面": ["Streamlit"]
  },
  "性能指标": {
    "处理速度": "100页/分钟",
    "准确率": "95%",
    "支持语言": ["中文", "英文"],
    "支持格式数量": 12
  }
}
